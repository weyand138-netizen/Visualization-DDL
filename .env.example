# Optional password for username admin.
DDL_PASSWORD=
# Optional additional accounts (JSON with username, passwordHash and displayName).
DDL_USERS_JSON=
# Bind to 0.0.0.0 only when direct LAN access is needed.
DDL_BIND=127.0.0.1
DDL_PORT=8080
DDL_BOT_TOKEN=
# Optional internal AstrBot DDL bridge; configure its token to match.
DDL_AI_URL=
# Public HTTPS hostname for deploy/compose.ubuntu.yaml.
DDL_DOMAIN=ddl.example.com
# Only needed by the optional AstrBot overlay; match your existing Docker network.
ASTRBOT_NETWORK=bot-network
